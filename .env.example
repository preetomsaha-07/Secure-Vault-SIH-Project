# ==============================================================================
# SECUREVAULT: ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# DO NOT COMMIT PRODUCTION SECRETS OR REAL KEYS TO REPOSITORIES

NODE_ENV=production
PORT=5000
CLIENT_URL=https://vault.organization.local

# JWT Authentication
# Must be at least 32 cryptographically random characters
JWT_SECRET=replace_with_high_entropy_secret_minimum_32_characters_here
JWT_EXPIRES_IN=2h

# Cryptographic Master Key (AES-256-GCM Envelope Encryption)
# 64 hex characters = 32 bytes (256-bit AES master key)
# Document keys are dynamically derived per document using HKDF-SHA256
MASTER_ENCRYPTION_KEY=replace_with_64_character_hex_string_representing_32_bytes_key

# Database Configuration
# In production, set to your Amazon RDS / PostgreSQL connection string
# If left empty, SecureVault automatically initializes its embedded relational engine
DATABASE_URL=postgresql://securevault_user:strong_password_here@postgres:5432/securevault_db
USE_EMBEDDED_DB=false
DATABASE_FILE=./vault_data.db

# Private Object Storage (AWS S3 or MinIO S3-Compatible)
STORAGE_PROVIDER=s3
STORAGE_LOCAL_DIR=./vault_storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace_with_iam_user_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_iam_user_secret_access_key
AWS_S3_BUCKET=securevault-confidential-evidence-private

# S3 Custom Endpoint (Required for on-prem MinIO, e.g. http://minio:9000)
S3_ENDPOINT=

# Demo Mode Flag (Set to false for strict production)
DEMO_MODE=true
